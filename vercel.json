{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix frontend ci",
  "buildCommand": "npm --prefix frontend run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://youtube-agent-production-ddb0e397.up.railway.app/api/$1"
    },
    {
      "source": "/output/(.*)",
      "destination": "https://youtube-agent-production-ddb0e397.up.railway.app/output/$1"
    },
    { "source": "/(.*)", "destination": "/" }
  ]
}
