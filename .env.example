MOTIVATIONOS_NICHE=Hindi English discipline and mindset
MOTIVATIONOS_TOPIC=Discipline and consistency
MOTIVATIONOS_DB_PATH=data/motivationos.sqlite3
MOTIVATIONOS_OUTPUT_DIR=data/productions
MOTIVATIONOS_LICENSED_ASSET_DIR=data/licensed-assets
MOTIVATIONOS_QUALITY_THRESHOLD=7.5
MOTIVATIONOS_SPEAKING_RATE_WPS=2.5

# Hugging Face Inference Providers are the only LLM backend.
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_PROVIDER=auto
HF_TIMEOUT_SECONDS=60
HF_MAX_RETRIES=2

# Credentialed multilingual Hindi/Hinglish speech; voice must be enabled on your account.
MOTIVATIONOS_TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Alternative real TTS service; select explicitly with MOTIVATIONOS_TTS_PROVIDER=edge-tts.
EDGE_TTS_VOICE=hi-IN-SwaraNeural

# Optional LangSmith tracing. This does not provide model inference.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=MotivationOS

# Local YouTube API. Keep this admin token and all client credentials private.
MOTIVATIONOS_ADMIN_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/youtube/auth/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
MOTIVATIONOS_YOUTUBE_VISIBILITY=private

# Daily analytics/report scheduler is opt-in and never publishes videos.
MOTIVATIONOS_SCHEDULER_ENABLED=false
MOTIVATIONOS_REPORT_HOUR_UTC=8
MOTIVATIONOS_REPORT_MINUTE_UTC=0
MOTIVATIONOS_REPORT_DIR=data/reports

# Optional SMTP delivery; leave unset to retain local reports only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=