MOTIVATIONOS_NICHE=Hindi English discipline and mindset
MOTIVATIONOS_TOPIC=Discipline and consistency
MOTIVATIONOS_DB_PATH=data/motivationos.sqlite3
MOTIVATIONOS_OUTPUT_DIR=data/productions
MOTIVATIONOS_LICENSED_ASSET_DIR=data/licensed-assets
MOTIVATIONOS_QUALITY_THRESHOLD=7.5
MOTIVATIONOS_SPEAKING_RATE_WPS=2.5

# Image provider: manual (default), pollinations, or pixabay for generated scene images.
IMAGE_PROVIDER=manual
# Pixabay API key; required when IMAGE_PROVIDER=pixabay.
PIXABAY_API_KEY=
# Pollinations image model name.
POLLINATIONS_MODEL=flux
# Optional Pollinations API key; leave blank for basic free-tier access.
POLLINATIONS_API_KEY=
# Requested output dimensions; defaults create vertical 9:16 images.
POLLINATIONS_WIDTH=1080
POLLINATIONS_HEIGHT=1920
# Per-request timeout in seconds.
POLLINATIONS_TIMEOUT_SECONDS=120
# The free tier is rate-limited to roughly one image request every 15 seconds.

# Select the application-wide LLM provider.
LLM_PROVIDER=groq

# Groq's OpenAI-compatible chat endpoint.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# DeepSeek's OpenAI-compatible chat endpoint.

# DeepSeek's OpenAI-compatible chat endpoint.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2

# Optional: Sarvam's OpenAI-compatible chat backend.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_MODEL_NAME=sarvam-105b

# Hugging Face settings are optional; used only with LLM_PROVIDER=huggingface.
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_PROVIDER=auto
HF_TIMEOUT_SECONDS=60
HF_MAX_RETRIES=2

# Existing production TTS path; set a provider explicitly before production.
MOTIVATIONOS_TTS_PROVIDER=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Alternative real TTS service; select explicitly with MOTIVATIONOS_TTS_PROVIDER=edge-tts.
EDGE_TTS_VOICE=hi-IN-SwaraNeural

# Independent approved-script audio module; blank disables provider selection.
MOTIVATIONOS_AUDIO_PROVIDER=
MOTIVATIONOS_AUDIO_TIMEOUT_SECONDS=120

# Optional LangSmith tracing. This does not provide model inference.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=MotivationOS

# Local YouTube API. Keep this admin token and all client credentials private.
MOTIVATIONOS_ADMIN_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/youtube/auth/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
MOTIVATIONOS_YOUTUBE_VISIBILITY=private

# Automatic publishing is opt-in and always requires public visibility.
AUTO_PUBLISH_ENABLED=false
AUTO_PUBLISH_CRON=0 9 * * *
YOUTUBE_PRIVACY_STATUS=public
AUTO_APPROVE_SCRIPTS=true
AUTO_APPROVE_PRODUCTIONS=true
MIN_SCRIPT_QUALITY_SCORE=75
DAILY_PIPELINE_MAX_SCRIPT_RETRIES=3
DAILY_PIPELINE_NICHE=
DAILY_PIPELINE_CRON=
MIN_AUDIO_QUALITY_SCORE=8.0
MIN_VIDEO_QUALITY_SCORE=8.0
MAX_UPLOADS_PER_DAY=5
YOUTUBE_DAILY_QUOTA_UNITS=10000
YOUTUBE_CATEGORY_ID=22
YOUTUBE_PLAYLIST_ID=
YOUTUBE_NOTIFY_SUBSCRIBERS=true
YOUTUBE_MADE_FOR_KIDS=false

# Scheduler is opt-in. AUTO_PUBLISH_ENABLED adds the automatic pipeline job.
MOTIVATIONOS_SCHEDULER_ENABLED=false
MOTIVATIONOS_REPORT_HOUR_UTC=8
MOTIVATIONOS_REPORT_MINUTE_UTC=0
MOTIVATIONOS_REPORT_DIR=data/reports

# Optional SMTP delivery; leave unset to retain local reports only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
